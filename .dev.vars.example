# Local dev secrets for `next dev` / `wrangler dev` (via @opennextjs/cloudflare).
# Copy to `.dev.vars` (gitignored) and fill in. In production these are set
# with `wrangler secret put <NAME>` instead of committed anywhere.

# Owner login for /admin. AUTH_SECRET must be set first, then generate
# ADMIN_PASSWORD_HASH with:
#   npm run hash-password -- "<AUTH_SECRET>" "<your-password>"
# Regenerate the hash any time AUTH_SECRET changes — it's derived from it.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Veriphone (https://veriphone.io) - looks up a reservation phone number's
# carrier so the confirmation can be emailed to that carrier's SMS gateway
# (e.g. 5551234567@txt.att.net), avoiding A2P 10DLC registration. Falls
# back to a console-logged stub when unset.
VERIPHONE_API_KEY=

# Resend (https://resend.com) - sends the reservation gateway "text" and
# notifies the owner of new band applications. Falls back to a
# console-logged stub when unset. RESEND_FROM_EMAIL must be on a domain
# you've verified in your Resend account (https://resend.com/domains) -
# a live domain is required before this will actually send anything.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=

# Turnstile (https://developers.cloudflare.com/turnstile/) - bot protection
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
